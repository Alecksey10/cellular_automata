# Конфигурация docker-compose в корне репозитория.
# Для локальной разработки бэкенда используется backend/.env (см. docs/configuration.md)

# BACKEND
BACKEND_API_PORT=8000
BACKEND_API_HOST=0.0.0.0

# POSTGRES / PGADMIN
DB_HOST=db
DB_PORT_OUTER=8080
DB_PORT_INNER=5432
DB_USER=postgres
DB_PASS=pass
DB_NAME=cellular_automata
PGADMIN_EMAIL=example@mail.ru
PGADMIN_PASSWORD=pass
PGADMIN_PORT=8081

# JWT
JWT_SECRET_KEY=12578JP51Q666A1
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ПУТИ
IMAGES_DIRECTORY="./app/images/images_data"
BACKEND_DATA_DIRECTORY="./datas/backend"

# BACKEND: разрешённые CORS-источники (перечисление через запятую)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# FRONTEND: адрес API, подставляется в сборку как build arg (VITE_API_BASE_URL).
# При доступе к приложению с другой машины укажите здесь IP хоста,
# например http://192.168.50.218:8000
VITE_API_BASE_URL=http://localhost:8000
