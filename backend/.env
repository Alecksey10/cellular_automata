# Конфигурация для локальной разработки бэкенда (бэкенд запускается на хосте,
# БД и pgAdmin — в docker). Используется pydantic-settings (app/config.py).
# Аналог для полного запуска через docker-compose — /.env в корне репозитория.

# BACKEND
BACKEND_API_PORT=8000
BACKEND_API_HOST=localhost

# POSTGRES / PGADMIN
DB_HOST=localhost
DB_PORT_OUTER=8080
DB_PORT_INNER=5432
DB_USER=postgres
DB_PASS=pass
DB_NAME=cellular_automata
PGADMIN_EMAIL=example@mail.ru
PGADMIN_PASSWORD=pass
PGADMIN_PORT=8081

# JWT
JWT_SECRET_KEY=12578JP51Q666A1
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ПУТИ (относительно каталога запуска backend/)
IMAGES_DIRECTORY="./app/images/images_data"

# Разрешённые CORS-источники (перечисление через запятую)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
